{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Lumen",
  "version": "0.2.0",
  "identifier": "app.lumen.player",
  "build": {
    "beforeDevCommand": "pnpm vite",
    "devUrl": "http://localhost:5199",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": []
      }
    }
  },
  "bundle": {
    "active": true,
    "category": "Music",
    "targets": "all",
    "icon": [
      "icons/icon.png"
    ]
  }
}
