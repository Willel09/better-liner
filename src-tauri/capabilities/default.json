{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "core:window:allow-start-dragging",
    "core:window:allow-set-fullscreen",
    "core:window:allow-close",
    "core:event:default",
    "dialog:allow-open",
    "updater:default",
    "process:allow-restart",
    "allow-platform",
    "allow-mini-toggle",
    "allow-discord-update",
    "allow-config-status",
    "allow-config-set",
    "allow-cache-get",
    "allow-cache-set",
    "allow-play-log",
    "allow-stats",
    "allow-yt-search",
    "allow-ai-chat",
    "allow-import-playlist",
    "allow-local-scan",
    "allow-local-allow",
    "allow-analyze-file",
    "allow-ytm-open"
  ],
  "remote": {
    "urls": [
      "http://localhost:47823/*",
      "http://localhost:5199/*"
    ]
  }
}
